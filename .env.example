# Reference for every environment variable used across the monorepo.
# This file documents them in one place; each app reads its own copy —
# see apps/api/.env.example, apps/worker/.env.example, apps/web/.env.local.example.
# `docker compose up` provides Postgres/Redis matching the defaults below.

# --- Database (api, worker) ---
DATABASE_URL="postgresql://techhub:techhub@localhost:5432/techhub"

# --- Redis (api, worker) ---
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- Auth (api) ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# --- CORS (api) ---
WEB_ORIGIN="http://localhost:3000"
PORT="4000"

# --- Razorpay (api) — from the Razorpay dashboard, Settings > API Keys / Webhooks ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Email (worker) — from resend.com ---
RESEND_API_KEY=""
ORDERS_FROM_EMAIL="orders@yourdomain.com"

# --- Media storage (api) — Cloudflare R2, optional, from the R2 dashboard ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# --- Error tracking (api, web) — optional, from sentry.io ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Frontend (web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
